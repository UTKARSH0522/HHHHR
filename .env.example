# RAZORPAY_KEY_ID: Public Razorpay Test/Live Key ID for checkout UI (never place Key Secret here).
RAZORPAY_KEY_ID=rzp_test_placeholder

# HRCONNECT_BACKEND_BASE_URL: HTTPS URL of deployed HRConnect backend (e.g. Cloud Run).
# For physical Android device DEBUG testing against a local backend, use your computer's LAN IP
# (e.g. http://192.168.1.42:8080) or http://localhost:8080 with `adb reverse tcp:8080 tcp:8080`.
# Leave as not_configured for offline Debug Sandbox Mode.
HRCONNECT_BACKEND_BASE_URL=not_configured
